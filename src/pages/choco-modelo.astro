      s+='<line x1="'+T(d.ic[0])+'" y1="12" x2="'+T(d.ic[1])+'" y2="12" stroke="'+tono+
         '" stroke-width="7" stroke-linecap="butt" opacity=".3"/>';
      s+='<line x1="'+T(d.ic[0])+'" y1="5" x2="'+T(d.ic[0])+'" y2="19" stroke="'+tono+
         '" stroke-width="1.5" vector-effect="non-scaling-stroke"/>';
      s+='<line x1="'+T(d.ic[1])+'" y1="5" x2="'+T(d.ic[1])+'" y2="19" stroke="'+tono+
         '" stroke-width="1.5" vector-effect="non-scaling-stroke"/>';
    }
    s+='<line x1="'+T(d.v)+'" y1="12" x2="'+T(d.v)+'" y2="12" stroke="'+tono+
       '" stroke-width="8.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/>';
    return s+'</svg>';
  }
  function pinta(id, filas, eje){
    var n=document.getElementById(id); if(!n) return; var h='';
    filas.forEach(function(d){
      var det=d.ic?('IC 95 % '+d.ic[0].toFixed(3).replace('.',',')+' – '+
                    d.ic[1].toFixed(3).replace('.',',')):(d.nota||'sin intervalo');
      h+='<div class="iv-fila"><div class="iv-et">'+d.et+'<small>'+
         d.v.toFixed(3).replace('.',',')+'  ·  '+det+'</small></div>'+
         '<div class="iv-pista">'+barra(d)+'</div></div>';
    });
    if(eje) h+='<div class="iv-eje"><div></div><div class="marcas"><span>0,0</span>'+
      '<span>0,25</span><span>0,50</span><span>0,75</span><span>1,0</span></div></div>';
    n.innerHTML=h;
  }
  pinta('iv-metricas',[
    {et:'AUC-ROC · logística', v:0.788, ic:[0.685,0.866], ref:0.5,
     aria:'AUC-ROC 0,788, intervalo 0,685 a 0,866'},
    {et:'AUC-ROC · XGBoost', v:0.748, ic:[0.642,0.832], ref:0.5,
     aria:'AUC-ROC 0,748, intervalo 0,642 a 0,832'},
    {et:'AUC-ROC · persistencia', v:0.714, tono:'base', ref:0.5, nota:'línea base, sin intervalo',
     aria:'AUC-ROC de la línea base, 0,714'},
    {et:'AUC-PR · logística', v:0.704, ic:[0.463,0.843], ref:0.334,
     aria:'AUC-PR 0,704, intervalo 0,463 a 0,843'},
    {et:'AUC-PR · XGBoost', v:0.628, ic:[0.427,0.789], ref:0.334,
     aria:'AUC-PR 0,628, intervalo 0,427 a 0,789'},
    {et:'Precisión@5 · logística', v:0.764, ic:[0.527,1.0], ref:0.334,
     aria:'Precisión en los cinco primeros, 0,764'},
    {et:'Cobertura con top-5', v:0.616, ic:[0.371,0.764],
     aria:'Cobertura de hechos priorizando cinco municipios, 0,616'}
  ], true);

  // --- matrices de confusion, a escala ---
  var MX=[
    {t:'Los 5 de mayor riesgo cada año', s:'55 alarmas · 16,1 % del territorio',
     VP:44, FP:11, FN:70, VN:216, prec:0.800, sens:0.386},
    {t:'Semáforo en nivel alto', s:'114 alarmas · 33,4 % del territorio',
     VP:70, FP:44, FN:44, VN:183, prec:0.614, sens:0.614},
    {t:'Probabilidad calibrada ≥ 0,33', s:'160 alarmas · 46,9 % del territorio',
     VP:83, FP:77, FN:31, VN:150, prec:0.519, sens:0.728}
  ];
  function celda(n, tot, clase, q){
    var alt=tot?Math.round(100*n/tot):0;
    return '<div class="celda '+clase+'"><i style="height:'+alt+'%;opacity:.22"></i>'+
           '<span class="n">'+n+'</span><span class="q">'+q+'</span></div>';
  }
  var cont=document.getElementById('matrices');
  if(cont){
    cont.innerHTML=MX.map(function(m){
      var f1=m.VP+m.FP, f2=m.FN+m.VN;
      return '<div class="mx"><h4>'+m.t+'</h4><p class="mx-sub">'+m.s+'</p>'+
        '<div class="mx-rej">'+
          '<div class="eje"></div><div class="eje">Hubo hecho</div><div class="eje">No hubo</div>'+
          '<div class="lat">Alarma<br>encendida</div>'+
            celda(m.VP,f1,'acierto','acierto')+celda(m.FP,f1,'fallo','falsa alarma')+
          '<div class="lat">Sin<br>alarma</div>'+
            celda(m.FN,f2,'fallo','se escapó')+celda(m.VN,f2,'acierto','correcto')+
        '</div>'+
        '<p class="mx-pie">precisión <b>'+m.prec.toFixed(3).replace('.',',')+'</b>'+
        '  ·  sensibilidad <b>'+m.sens.toFixed(3).replace('.',',')+'</b></p></div>';
    }).join('');
  }
})();
</script>
