    s+='<line x1="0" y1="12" x2="100" y2="12" stroke="var(--regla)" stroke-width="1"'+
       ' vector-effect="non-scaling-stroke"/>';
    // referencia de azar
    if(d.ref!==undefined){
      s+='<line x1="'+T(d.ref)+'" y1="2" x2="'+T(d.ref)+'" y2="22" stroke="var(--suave)"'+
         ' stroke-width="1" stroke-dasharray="3 3" vector-effect="non-scaling-stroke"/>';
    }
    // intervalo
    if(d.ic){
      s+='<line x1="'+T(d.ic[0])+'" y1="12" x2="'+T(d.ic[1])+'" y2="12" stroke="'+tono+
         '" stroke-width="7" stroke-linecap="butt" opacity=".3"/>';
      s+='<line x1="'+T(d.ic[0])+'" y1="5" x2="'+T(d.ic[0])+'" y2="19" stroke="'+tono+
         '" stroke-width="1.5" vector-effect="non-scaling-stroke"/>';
      s+='<line x1="'+T(d.ic[1])+'" y1="5" x2="'+T(d.ic[1])+'" y2="19" stroke="'+tono+
         '" stroke-width="1.5" vector-effect="non-scaling-stroke"/>';
    }
    // punto: linea de longitud cero con remate redondo, para que el estirado
    // horizontal del viewBox no lo convierta en elipse
    s+='<line x1="'+T(d.v)+'" y1="12" x2="'+T(d.v)+'" y2="12" stroke="'+tono+
       '" stroke-width="8.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/>';
    s+='</svg>';
    return s;
  }
  function pinta(id, filas, eje){
    var n=document.getElementById(id); if(!n) return;
    var h='';
    filas.forEach(function(d){
      var det=d.ic?('IC 95 % '+d.ic[0].toFixed(3).replace('.',',')+' – '+
                    d.ic[1].toFixed(3).replace('.',',')):(d.nota||'sin intervalo');
      h+='<div class="iv-fila"><div class="iv-et">'+d.et+
         '<small>'+d.v.toFixed(3).replace('.',',')+'  ·  '+det+'</small></div>'+
         '<div class="iv-pista">'+barra(d)+'</div></div>';
    });
    if(eje){
      h+='<div class="iv-eje"><div></div><div class="marcas"><span>0,0</span>'+
         '<span>0,25</span><span>0,50</span><span>0,75</span><span>1,0</span></div></div>';
    }
    n.innerHTML=h;
  }

  pinta('iv-antes',[
    {et:'AUC-PR del modelo', v:0.834, tono:'pub', nota:'como se publicó', ref:0.334,
     aria:'AUC-PR publicado de 0,834, sin intervalo'},
    {et:'Ordenamiento sobre 2026', v:0.337, tono:'pub', nota:'«señal invertida»', ref:0.5,
     aria:'AUC de 0,337 publicado sin intervalo'}
  ]);

  pinta('iv-despues',[
    {et:'AUC-PR del modelo', v:0.704, ic:[0.463,0.843], ref:0.334,
     aria:'AUC-PR de 0,704 con intervalo de 0,463 a 0,843'},
    {et:'Ordenamiento sobre 2026', v:0.337, ic:[0.120,0.577], tono:'nov', ref:0.5,
     aria:'AUC de 0,337 con intervalo de 0,120 a 0,577, que contiene 0,5'}
  ], true);

  pinta('iv-metricas',[
    {et:'AUC-ROC · logística', v:0.788, ic:[0.685,0.866], ref:0.5,
     aria:'AUC-ROC 0,788, intervalo 0,685 a 0,866'},
    {et:'AUC-ROC · XGBoost', v:0.748, ic:[0.642,0.832], ref:0.5,
     aria:'AUC-ROC 0,748, intervalo 0,642 a 0,832'},
    {et:'AUC-ROC · persistencia', v:0.714, tono:'base', ref:0.5, nota:'línea base, sin intervalo',
     aria:'AUC-ROC de la línea base, 0,714'},
    {et:'AUC-PR · logística', v:0.704, ic:[0.463,0.843], ref:0.334,
     aria:'AUC-PR 0,704, intervalo 0,463 a 0,843'},
    {et:'AUC-PR · XGBoost', v:0.628, ic:[0.427,0.789], ref:0.334,
     aria:'AUC-PR 0,628, intervalo 0,427 a 0,789'},
    {et:'Precisión@5 · logística', v:0.764, ic:[0.527,1.0], ref:0.334,
     aria:'Precisión en los cinco primeros, 0,764'},
    {et:'Precisión@5 · XGBoost', v:0.818, ic:[0.527,0.945], ref:0.334,
     aria:'Precisión en los cinco primeros con XGBoost, 0,818'},
    {et:'Cobertura con top-5', v:0.616, ic:[0.371,0.764],
     aria:'Cobertura de hechos priorizando cinco municipios, 0,616'}
  ], true);
})();
