          '<div class="col">Después del acuerdo<br>2017–2026</div>';
    ['Memoria histórica','Corredor en disputa'].forEach(function(f){
      h+='<div class="fil">'+f+'</div>';
      DD.filter(function(d){return d.fila===f}).forEach(function(d){
        var ok = d.ic[0] > 0.5;            // el intervalo excluye el azar por arriba
        var nulo = d.ic[0] <= 0.5 && d.ic[1] >= 0.5;
        h+='<div class="cel '+(d.col===0?'antes':'post')+' '+(ok?'si':'no')+'">'+
           '<div class="auc">'+d.v.toFixed(3).replace('.',',')+'</div>'+
           '<div class="ic">IC '+d.ic[0].toFixed(3).replace('.',',')+' – '+
             d.ic[1].toFixed(3).replace('.',',')+'</div>'+
           '<div class="ver">'+mini(d, ok)+'</div>'+
           '<div class="vd">'+(ok?'ordena':(nulo?'contiene el azar':'por debajo'))+'</div></div>';
      });
    });
    cont.innerHTML=h;
    document.getElementById('dd-pie').innerHTML =
      'AUC del ordenamiento directo, sin modelo, en cada régimen. La vertical punteada es el 0,500 '+
      'del azar; los intervalos del 95 % salen de remuestrear municipios. <b>Antes</b>: 527 '+
      'municipio-año de 2000 a 2016, 155 con reclutamiento registrado. <b>Después</b>: los 31 '+
      'municipios y los 6 ataques con dron de 2026. <b>Lo que no muestra:</b> que la celda de abajo '+
      'a la derecha es la única construida sabiendo el desenlace, y por eso la única que no prueba '+
      'nada por sí sola.';
  }

  // ---- barra de intervalo ----
  function barra(d){
    var T=function(v){return v*100};
    var c=d.tono==='pub'?'var(--a)':(d.tono==='nov'?'var(--ac)':
          (d.tono==='base'?'var(--suave)':'var(--b)'));
    var s='<svg viewBox="0 0 100 24" preserveAspectRatio="none" role="img" aria-label="'+
      (d.aria||'')+'">';
    s+='<line x1="0" y1="12" x2="100" y2="12" stroke="var(--regla)" stroke-width="1"'+
       ' vector-effect="non-scaling-stroke"/>';
    if(d.ref!==undefined)
      s+='<line x1="'+T(d.ref)+'" y1="2" x2="'+T(d.ref)+'" y2="22" stroke="var(--suave)"'+
         ' stroke-width="1" stroke-dasharray="3 3" vector-effect="non-scaling-stroke"/>';
    if(d.ic){
      s+='<line x1="'+T(d.ic[0])+'" y1="12" x2="'+T(d.ic[1])+'" y2="12" stroke="'+c+
         '" stroke-width="7" opacity=".3"/>';
      [d.ic[0],d.ic[1]].forEach(function(x){
        s+='<line x1="'+T(x)+'" y1="5" x2="'+T(x)+'" y2="19" stroke="'+c+
           '" stroke-width="1.5" vector-effect="non-scaling-stroke"/>';});
    }
    s+='<line x1="'+T(d.v)+'" y1="12" x2="'+T(d.v)+'" y2="12" stroke="'+c+
       '" stroke-width="8.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/>';
    return s+'</svg>';
  }
  var n=document.getElementById('iv-metricas');
  if(n){
    var D=[
      {et:'AUC-ROC · logística', v:0.788, ic:[0.685,0.866], ref:0.5},
      {et:'AUC-ROC · XGBoost', v:0.748, ic:[0.642,0.832], ref:0.5},
      {et:'AUC-ROC · persistencia', v:0.714, tono:'base', ref:0.5, nota:'línea base, sin intervalo'},
      {et:'AUC-PR · logística', v:0.704, ic:[0.463,0.843], ref:0.334},
      {et:'AUC-PR · XGBoost', v:0.628, ic:[0.427,0.789], ref:0.334},
      {et:'Precisión@5 · logística', v:0.764, ic:[0.527,1.0], ref:0.334},
      {et:'Cobertura con top-5', v:0.616, ic:[0.371,0.764]}
    ];
    n.innerHTML = D.map(function(d){
      var det=d.ic?('IC 95 % '+d.ic[0].toFixed(3).replace('.',',')+' – '+
                    d.ic[1].toFixed(3).replace('.',',')):(d.nota||'');
      return '<div class="iv-fila"><div class="iv-et">'+d.et+'<small>'+
        d.v.toFixed(3).replace('.',',')+'  ·  '+det+'</small></div>'+
        '<div class="iv-pista">'+barra(d)+'</div></div>';
    }).join('') +
    '<div class="iv-eje"><div></div><div class="marcas"><span>0,0</span><span>0,25</span>'+
    '<span>0,50</span><span>0,75</span><span>1,0</span></div></div>';
  }

  // ---- matrices de confusion ----
  var MX=[
    {t:'Los 5 de mayor riesgo cada año', s:'55 alarmas · 16,1 % del territorio',
     VP:44, FP:11, FN:70, VN:216, prec:0.800, sens:0.386},
    {t:'Semáforo en nivel alto', s:'114 alarmas · 33,4 % del territorio',
     VP:70, FP:44, FN:44, VN:183, prec:0.614, sens:0.614},
    {t:'Probabilidad calibrada ≥ 0,33', s:'160 alarmas · 46,9 % del territorio',
     VP:83, FP:77, FN:31, VN:150, prec:0.519, sens:0.728}
  ];
  function celda(v, tot, clase, q){
    var alt=tot?Math.round(100*v/tot):0;
    return '<div class="celda '+clase+'"><i style="height:'+alt+'%;opacity:.22"></i>'+
           '<span class="n">'+v+'</span><span class="q">'+q+'</span></div>';
  }
  var cm=document.getElementById('matrices');
  if(cm){
    cm.innerHTML=MX.map(function(m){
      var f1=m.VP+m.FP, f2=m.FN+m.VN;
      return '<div class="mx"><h4>'+m.t+'</h4><p class="mx-sub">'+m.s+'</p><div class="mx-rej">'+
        '<div class="eje"></div><div class="eje">Hubo hecho</div><div class="eje">No hubo</div>'+
        '<div class="lat">Alarma<br>encendida</div>'+
          celda(m.VP,f1,'acierto','acierto')+celda(m.FP,f1,'fallo','falsa alarma')+
        '<div class="lat">Sin<br>alarma</div>'+
          celda(m.FN,f2,'fallo','se escapó')+celda(m.VN,f2,'acierto','correcto')+
        '</div><p class="mx-pie">precisión <b>'+m.prec.toFixed(3).replace('.',',')+
        '</b>  ·  sensibilidad <b>'+m.sens.toFixed(3).replace('.',',')+'</b></p></div>';
    }).join('');
  }
})();
</script>
