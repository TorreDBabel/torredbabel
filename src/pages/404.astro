---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada">
  <section class="seccion seccion--final">
    <div class="columna">
      <p class="etiqueta">Error 404</p>
      <h1 class="articulo-titulo">Esta página no existe, o cambió de lugar</h1>
      <p style="margin-top: 1.5rem">Puede volver a la <a href="/">portada</a> o ver los <a href="/articulos">artículos</a>.</p>
    </div>
  </section>
</Base>
