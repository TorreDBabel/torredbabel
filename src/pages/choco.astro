<script is:inline>
/* Registro «Placa» · transiciones. Sin este guion la página se lee completa y marcada. */
(() => {
  const raiz = document.documentElement;
  raiz.classList.add('js'); raiz.lang = 'es';
  if (!('IntersectionObserver' in window)) return;
  const movil = () => matchMedia('(max-width: 720px)').matches;
  const cruzo = (lista, linea, rect) => { let a = null; for (const x of lista) if (rect(x).top < linea) a = x; return a; };
  const tareas = []; let pendiente = false;
  const programar = () => { if (pendiente) return; pendiente = true; requestAnimationFrame(() => { pendiente = false; tareas.forEach(t => t()); }); };
  addEventListener('scroll', programar, { passive: true }); addEventListener('resize', programar);

  const ver = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.remove('por-ver'); ver.unobserve(e.target); } }), { rootMargin: '0px 0px -18% 0px' });
  document.querySelectorAll('.columna > p').forEach(p => { if (p.querySelector('mark') && p.getBoundingClientRect().top > innerHeight * .82) { p.classList.add('por-ver'); ver.observe(p); } });

  document.querySelectorAll('.apertura').forEach(ap => {
    ap.classList.add('viva');
    const copias = ap.querySelectorAll('.apertura-copia'), disp = [...ap.querySelectorAll('.apertura-disparador')];
    tareas.push(() => {
      const d = cruzo(disp, innerHeight * .5, x => x.getBoundingClientRect()), n = d ? d.dataset.paso : '1';
      if (ap.dataset.estado === n) return;
      ap.dataset.estado = n; copias.forEach(c => c.classList.toggle('activa', c.dataset.paso === n));
    });
  });

  document.querySelectorAll('.recorrido').forEach(rec => {
    rec.classList.add('vivo');
    const piezas = rec.querySelectorAll('[data-t]'), cabeza = rec.querySelector('.figura-cabeza');
    const escena = rec.querySelector('.recorrido-escena'), pasos = [...rec.querySelectorAll('.recorrido-paso')];
    const medir = () => rec.style.setProperty('--alto-escena', escena.offsetHeight + 'px');
    medir(); addEventListener('resize', medir); document.fonts && document.fonts.ready.then(medir);
    const tarjeta = p => p.querySelector('.paso').getBoundingClientRect();
    const aplicar = (paso, fin) => {
      const clave = fin ? 'fin' : (paso ? paso.dataset.n : '');
      if ((rec.dataset.paso || '') === clave) return;
      const foco = paso ? paso.dataset.foco.split(' ') : null, lazos = paso && paso.dataset.lazo ? paso.dataset.lazo.split(' ') : [];
      piezas.forEach(p => { p.classList.toggle('atenuado', !!foco && !foco.includes(p.dataset.t)); p.classList.toggle('con-lazo', lazos.includes(p.dataset.t)); });
      if (cabeza) cabeza.classList.toggle('atenuado', !!foco);
      if (clave) rec.dataset.paso = clave; else delete rec.dataset.paso;
    };
    tareas.push(() => {
      const linea = innerHeight * (movil() ? .75 : .5), actual = cruzo(pasos, linea, tarjeta), ultimo = pasos[pasos.length - 1];
      if (actual === ultimo && tarjeta(ultimo).bottom < linea - innerHeight * .2) aplicar(null, true); else aplicar(actual);
    });
  });
  tareas.forEach(t => t());
})();
</script>

<script is:inline>
/* Tablero territorial · el mapa vivo */
(() => {
  const D = window.__TAB, M = D.mun, SVG = 'http://www.w3.org/2000/svg';
  const el = (t, a) => { const n = document.createElementNS(SVG, t); for (const k in a) n.setAttribute(k, a[k]); return n; };
  const AN = D.anios, ULT = AN.length - 1;

  /* Registro «Placa»: el tablero vive sobre la losa, así que el valor alto es CLARO.
     Las rampas arrancan por encima del fondo para que el mínimo siga siendo visible,
     y saltan la banda intermedia donde ni letra clara ni letra oscura serían legibles.
     Ámbar: lo que el archivo contó. Agua: lo que mostró el dato. Grafito: lo que permanece. */
  const RAMPAS = {
    ambar:  ['#2e2619', '#4a3b1c', '#6e5015', '#a87a1d', '#dcab45', '#f4ddaa'],
    agua:   ['#1c2b33', '#2a4249', '#265b70', '#4e9fbd', '#8dcadd', '#c6e6f0'],
    neutro: ['#2c3034', '#43484e', '#5c6168', '#8d9399', '#b4b9be', '#e2e0da']
  };
  const hex = h => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
  const tono = (r, t) => {
    const c = RAMPAS[r].map(hex), n = c.length - 1;
    t = Math.max(0, Math.min(1, t));
    const i = Math.min(Math.floor(t * n), n - 1), f = t * n - i;
    return 'rgb(' + c[i].map((v, j) => Math.round(v + (c[i + 1][j] - v) * f)).join(',') + ')';
  };
  const degradado = r => 'linear-gradient(90deg,' + RAMPAS[r].join(',') + ')';
  const divergente = t => t < 0 ? tono('ambar', -t) : tono('agua', t);

  const CAPAS = [
    { id: 'casos', n: 'Reclutamiento', r: 'ambar', esc: 'raiz', u: 'hechos acumulados', tiempo: true,
      v: (m, a) => a >= ULT ? m.casos : m.s.slice(0, a + 1).reduce((x, y) => x + y, 0),
      clave: 'Cuanto más claro, más hechos acumulados. Mueva la barra de tiempo y verá el archivo formándose año por año. La escala es de raíz cuadrada, o Quibdó borraría a los otros treinta.' },
    { id: 'idx', n: 'Corredor en disputa', r: 'agua', esc: 'lin', u: 'índice 0–100', dec: 1,
      v: m => m.idx,
      clave: 'Geografía fluvial, economía de la coca y divergencia entre presente y pasado. No usa el historial de reclutamiento.' },
    { id: 'coca', n: 'Cultivos de coca', r: 'ambar', esc: 'raiz', u: 'hectáreas acumuladas',
      v: m => m.coca,
      clave: 'Hectáreas acumuladas. No predice el reclutamiento, pero marca dónde hay algo por lo que valga la pena pelear.' },
    { id: 'rib', n: 'Ribereñidad', r: 'neutro', esc: 'lin', u: 'índice 0–100', dec: 1,
      v: m => m.rib,
      clave: 'Cercanía al cauce navegable más próximo, de 0 a 100. Es contexto: no cambia con el conflicto, lo precede.' },
    { id: 'alertas', n: 'Alertas tempranas', r: 'agua', esc: 'lin', u: 'alertas 2016–2025',
      v: m => m.alertas,
      clave: 'Alertas emitidas por la Defensoría del Pueblo entre 2016 y 2025, incluidas las de inminencia.' },
    { id: 'semaforo', n: 'Semáforo del modelo', r: 'ambar', esc: 'cat', u: 'nivel de alerta',
      v: m => m.riesgo,
      clave: 'Los tres niveles que el modelo produjo al cierre de 2016. Validados: 79,0 % de reclutamiento real en ALTA, 65,0 % en MEDIA y 53,2 % en BAJA.' },
    { id: 'giro', n: 'El giro', r: 'div', esc: 'div', u: 'puestos que gana o pierde',
      v: m => m.rh - m.rc,
      clave: 'Las dos lecturas enfrentadas. En agua, los municipios que el índice de corredor sube respecto del semáforo; en ámbar, los que baja. Es el hallazgo central del proyecto, puesto a la mano.' }
  ];
  /* Los tres niveles se separan en claridad 2,5× y 3,3×, no solo en tono, y además
     van siempre con su palabra escrita. */
  const NIVEL = { BAJA: '#50555b', MEDIA: '#a87a1d', ALTA: '#f4ddaa' };

  let capa = CAPAS[0], sel = null, anio = ULT, gira = -1;

  const num = (v, d) => v.toLocaleString('es-CO', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 });
  const bruto = m => capa.v(m, anio);
  const crudo = m => { const v = bruto(m); return capa.esc === 'raiz' ? Math.sqrt(v) : v; };
  let lo = 0, hi = 1, ext = 1;
  const medir = () => {
    if (capa.esc === 'div') { ext = Math.max(1, ...M.map(m => Math.abs(bruto(m)))); return; }
    const v = M.map(crudo); lo = Math.min(...v); hi = Math.max(...v);
  };
  const t01 = m => hi === lo ? .5 : (crudo(m) - lo) / (hi - lo);
  const relleno = m => capa.esc === 'cat' ? NIVEL[m.nivel]
                     : capa.esc === 'div' ? divergente(bruto(m) / ext)
                     : tono(capa.r, t01(m));
  const texto = m => {
    if (capa.esc === 'cat') return m.nivel;
    const v = bruto(m);
    if (capa.esc === 'div') return (v > 0 ? '+' : '') + num(v);
    return num(v, capa.dec || 0) + (capa.id === 'coca' ? ' ha' : '');
  };

  /* --- mapa --- */
  const mapa = document.getElementById('mapa'), marco = mapa.parentNode, globo = document.getElementById('globo');
  mapa.setAttribute('viewBox', `0 0 ${D.w} ${D.h}`);
  const gMun = el('g'), gRio = el('g'), gDron = el('g'), gNum = el('g');
  mapa.append(gMun, gRio, gDron, gNum);
  const rutas = {};
  const asomar = (m, e) => {
    globo.innerHTML = `<b>${m.m}</b>${capa.n}: ${texto(m)}`;
    globo.classList.add('ver');
    const r = marco.getBoundingClientRect();
    const x = Math.min(Math.max(e.clientX - r.left + 14, 4), r.width - globo.offsetWidth - 4);
    globo.style.left = x + 'px'; globo.style.top = (e.clientY - r.top - globo.offsetHeight - 10) + 'px';
  };
  M.forEach(m => {
    const p = el('path', { d: m.d, class: 'mun', tabindex: '0', role: 'button', 'aria-label': m.m });
    p.addEventListener('click', () => { gira = -1; pintarGira(); elegir(m.cod); });
    p.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); elegir(m.cod); } });
    p.addEventListener('pointermove', e => asomar(m, e));
    p.addEventListener('pointerleave', () => globo.classList.remove('ver'));
    gMun.appendChild(p); rutas[m.cod] = p;
    /* El rótulo lleva halo por CSS, así que no depende del relleno ni de un umbral. */
    const t = el('text', { x: m.cx, y: m.cy + 3, 'text-anchor': 'middle', class: 'mnum' });
    t.textContent = m.n; gNum.appendChild(t);
    if (m.dron) gDron.appendChild(el('path', { d: m.d, class: 'ataque' }));
  });
  /* Desvíos del rótulo de cada río para que no se monte sobre el número de un municipio. */
  const DESV = { 'Atrato': [13, -4], 'San Juan': [34, 34], 'Baudó': [-76, 24] };
  D.rios.forEach(r => {
    gRio.appendChild(el('path', { d: r.d, class: 'rio' }));
    const o = DESV[r.n] || [12, 0];
    const t = el('text', { x: r.lx + o[0], y: r.ly + o[1], class: 'rio-et' });
    t.textContent = r.n.toUpperCase(); gRio.appendChild(t);
  });

  /* --- capas y conmutadores --- */
  const ulCapas = document.getElementById('capas');
  CAPAS.forEach(c => {
    const li = document.createElement('li'), b = document.createElement('button');
    b.type = 'button'; b.className = 'capa'; b.textContent = c.n;
    b.setAttribute('aria-pressed', c === capa ? 'true' : 'false');
    b.addEventListener('click', () => { capa = c; pintar(); });
    c._b = b; li.appendChild(b); ulCapas.appendChild(li);
  });
  let verRios = true, verDron = true;
  const bRios = document.getElementById('conmuta-rios'), bDron = document.getElementById('conmuta-dron');
  bRios.addEventListener('click', () => { verRios = !verRios; bRios.setAttribute('aria-pressed', verRios); gRio.style.opacity = verRios ? 1 : 0; });
  bDron.addEventListener('click', () => { verDron = !verDron; bDron.setAttribute('aria-pressed', verDron); gDron.style.opacity = verDron ? 1 : 0; });

  /* --- escala --- */
  const esMin = document.getElementById('escala-min'), esMax = document.getElementById('escala-max');
  const esBar = document.getElementById('escala-barra'), esTit = document.getElementById('escala-tit');
  function escala() {
    esTit.textContent = capa.u;
    if (capa.esc === 'cat') {
      esBar.style.background = 'linear-gradient(90deg,#50555b 0 33.3%,#a87a1d 33.3% 66.6%,#f4ddaa 66.6%)';
      esMin.textContent = 'BAJA'; esMax.textContent = 'ALTA';
    } else if (capa.esc === 'div') {
      esBar.style.background = 'linear-gradient(90deg,' + RAMPAS.ambar.slice().reverse().join(',') + ',' + RAMPAS.agua.join(',') + ')';
      esMin.textContent = '−' + num(ext) + ' baja'; esMax.textContent = 'sube +' + num(ext);
    } else {
      esBar.style.background = degradado(capa.r);
      const vs = M.map(bruto);
      esMin.textContent = num(Math.min(...vs), capa.dec || 0);
      esMax.textContent = num(Math.max(...vs), capa.dec || 0);
    }
  }

  /* --- barra de tiempo: el archivo formándose --- */
  const caja = document.getElementById('tiempo'), rango = document.getElementById('tiempo-rango');
  const serie = document.getElementById('tiempo-serie'), tEt = document.getElementById('tiempo-et');
  function pintarSerie() {
    const W = 340, H = 30, n = D.dep.length, a = W / n, mx = Math.max(...D.dep);
    let b = '';
    D.dep.forEach((v, i) => {
      const h = Math.max(1.5, (v / mx) * (H - 6));
      b += `<rect x="${(i * a + .5).toFixed(1)}" y="${(H - 2 - h).toFixed(1)}" width="${(a - 1).toFixed(1)}" height="${h.toFixed(1)}" fill="${i <= anio ? '#dcab45' : '#30363c'}"></rect>`;
    });
    serie.innerHTML = `<svg class="tiempo-serie" viewBox="0 0 ${W} ${H}" role="img" aria-label="Hechos por año en todo el departamento entre 1983 y 2016">${b}</svg>`;
  }
  rango.addEventListener('input', () => { anio = +rango.value; pintar(true); });

  /* --- recorrido guiado por los seis atacados --- */
  const ATAC = M.filter(m => m.dron).sort((a, b) => a.rc - b.rc);
  const giraEt = document.getElementById('gira-et');
  function pintarGira() {
    giraEt.textContent = gira < 0 ? 'Recorrer los seis municipios atacados'
      : `${gira + 1} de 6 · ${ATAC[gira].m}`;
  }
  const mover = d => {
    gira = gira < 0 ? (d > 0 ? 0 : ATAC.length - 1) : (gira + d + ATAC.length) % ATAC.length;
    pintarGira(); elegir(ATAC[gira].cod);
  };
  document.getElementById('gira-prev').addEventListener('click', () => mover(-1));
  document.getElementById('gira-next').addEventListener('click', () => mover(1));

  /* --- chispa: la serie anual del municipio, en la casilla del panel --- */
  function chispa(m) {
    const W = 340, H = 54, n = m.s.length, mx = Math.max(1, ...m.s), a = W / n;
    let b = '';
    m.s.forEach((v, i) => {
      const h = v === 0 ? 1 : Math.max(2, (v / mx) * (H - 12));
      const c = v === 0 ? '#3c4248' : (i <= anio ? '#dcab45' : '#30363c');
      b += `<rect x="${(i * a + .6).toFixed(1)}" y="${(H - 10 - h).toFixed(1)}" width="${(a - 1.2).toFixed(1)}" height="${h.toFixed(1)}" fill="${c}"></rect>`;
    });
    const hoy = capa.tiempo && anio < n - 1 ? `<rect class="chispa-hoy" x="${((anio + 1) * a - .6).toFixed(1)}" y="0" width="1.4" height="${H - 8}"></rect>` : '';
    return `<svg class="chispa" viewBox="0 0 ${W} ${H}" role="img" aria-label="Hechos de reclutamiento por año entre 1983 y 2016 en ${m.m}: máximo de ${mx} en un año">${b}${hoy}<line x1="0" y1="${H - 9.5}" x2="${W}" y2="${H - 9.5}" stroke="#5c6168" stroke-width="1"></line></svg>`;
  }

  /* --- ficha --- */
  const ficha = document.getElementById('ficha');
  function pintarFicha(m) {
    const d = [
      [num(m.casos), 'hechos 1983–2016'], [m.rh + '/31', 'puesto · semáforo'],
      [m.rc + '/31', 'puesto · corredor'], [num(m.coca, m.coca < 100 ? 1 : 0), 'hectáreas de coca'],
      [num(m.rib, 1), 'ribereñidad'], [num(m.post), 'actividad 2016–2025'],
      [num(m.alertas), 'alertas tempranas'], [num(m.farc_act), 'años con hechos']
    ];
    const mx = Math.max(...m.s), anioMx = AN[m.s.indexOf(mx)], g = m.rh - m.rc;
    ficha.innerHTML =
      `<div class="ficha-cabeza"><h3>${m.m}</h3>` +
      `<span class="ficha-sello s-${m.nivel.toLowerCase()}">${m.nivel}</span>` +
      `<span class="ficha-num">N.º ${m.n} en el mapa</span></div>` +
      `<p class="ficha-rio">${m.drio < .6 ? 'Asentado sobre el cauce del ' + m.rio + '.' : 'A ' + num(m.drio, 1) + ' km del ' + m.rio + ', su cauce más próximo.'} Población media del periodo: ${num(m.pob)} habitantes. ` +
      (g === 0 ? 'Las dos lecturas lo sitúan en el mismo puesto.'
        : g > 0 ? `El índice de corredor lo sube ${g} ${g === 1 ? 'puesto' : 'puestos'} respecto del semáforo.`
        : `El índice de corredor lo baja ${-g} ${g === -1 ? 'puesto' : 'puestos'} respecto del semáforo.`) + `</p>` +
      chispa(m) +
      `<p class="chispa-pie etiqueta"><span>1983</span><span>${mx > 0 ? 'Año más intenso: ' + anioMx + ' · ' + mx + (mx === 1 ? ' hecho' : ' hechos') : 'Sin hechos registrados en la serie'}</span><span>2016</span></p>` +
      `<ul class="ficha-datos">` + d.map(x => `<li><span class="v">${x[0]}</span><span class="k">${x[1]}</span></li>`).join('') + `</ul>` +
      (m.dron ? `<p class="ficha-dron">Sufrió un ataque con dron cargado con explosivos en 2026. El semáforo lo situaba en el puesto ${m.rh} de 31; el índice de corredor, en el ${m.rc}.</p>` : '');
  }

  /* --- ranking --- */
  const rank = document.getElementById('ranking'), rankTit = document.getElementById('rank-tit');
  const filas = {};
  function pintarRank() {
    rank.textContent = ''; for (const k in filas) delete filas[k];
    rankTit.textContent = 'Los 31, ordenados por ' + capa.n.toLowerCase();
    const orden = M.slice().sort((a, b) => bruto(b) - bruto(a) || a.n - b.n);
    orden.forEach((m, i) => {
      const li = document.createElement('li'), b = document.createElement('button');
      const ancho = capa.esc === 'div' ? Math.abs(bruto(m)) / ext * 100 : t01(m) * 100;
      b.type = 'button'; b.className = 'rank-fila';
      b.innerHTML = `<span class="rank-pos">${i + 1}</span>` +
        `<span class="rank-nom">${m.dron ? '<i class="rank-dron"></i>' : ''}${m.m}</span>` +
        `<span class="rank-barra"><i style="width:${Math.max(3, ancho).toFixed(0)}%;background:${relleno(m)}"></i></span>` +
        `<span class="rank-val">${texto(m)}</span>`;
      b.addEventListener('click', () => { gira = -1; pintarGira(); elegir(m.cod); });
      li.appendChild(b); rank.appendChild(li); filas[m.cod] = b;
    });
    marcarSel();
  }

  function marcarSel() {
    M.forEach(m => rutas[m.cod].classList.toggle('sel', m.cod === sel));
    for (const c in filas) filas[c].setAttribute('aria-current', c === sel ? 'true' : 'false');
  }
  function elegir(cod) {
    sel = cod; marcarSel();
    const m = M.find(x => x.cod === cod); if (m) pintarFicha(m);
  }

  function pintar(soloTiempo) {
    medir();
    CAPAS.forEach(c => c._b.setAttribute('aria-pressed', c === capa ? 'true' : 'false'));
    document.getElementById('tablero-clave').textContent = capa.clave;
    caja.hidden = !capa.tiempo;
    if (capa.tiempo) {
      if (!soloTiempo) { anio = ULT; rango.value = ULT; }
      pintarSerie();
      tEt.textContent = anio >= ULT ? 'Acumulado completo · 1983 a 2016'
        : 'Acumulado hasta ' + AN[anio] + ' · ' + num(M.reduce((s, m) => s + bruto(m), 0)) + ' de 361 hechos';
    } else if (!soloTiempo) { anio = ULT; }
    M.forEach(m => rutas[m.cod].setAttribute('fill', relleno(m)));
    escala(); pintarRank();
    if (sel) { const m = M.find(x => x.cod === sel); if (m) pintarFicha(m); }
  }

  /* --- franjas del método: tres bloques sobre la losa --- */
  const franjas = document.getElementById('franjas');
  if (franjas) franjas.innerHTML =
    '<div style="display:flex;gap:4px;align-items:stretch">' +
    '<div class="atenuable" data-t="ent" style="flex:26;background:#a87a1d;padding:1.1rem 1rem">' +
      '<p style="margin:0;font:400 1.375rem/1.1 var(--titular);letter-spacing:.04em;text-transform:uppercase;color:#11151a">entrenamiento</p>' +
      '<p style="margin:.45rem 0 0;font:400 .6875rem/1.3 var(--mono);letter-spacing:.09em;color:#11151a">1983 – 2008</p></div>' +
    '<div class="atenuable" data-t="col" style="flex:4;background:#50555b;padding:1.1rem .6rem">' +
      '<p style="margin:0;font:400 1.05rem/1.1 var(--titular);letter-spacing:.04em;text-transform:uppercase;color:#f4f2ec">colchón</p>' +
      '<p style="margin:.45rem 0 0;font:400 .6875rem/1.3 var(--mono);letter-spacing:.09em;color:#f4f2ec">4 años</p></div>' +
    '<div class="atenuable" data-t="eva" style="flex:4;background:#4e9fbd;padding:1.1rem .6rem">' +
      '<p style="margin:0;font:400 1.05rem/1.1 var(--titular);letter-spacing:.04em;text-transform:uppercase;color:#11151a">evaluación</p>' +
      '<p style="margin:.45rem 0 0;font:400 .6875rem/1.3 var(--mono);letter-spacing:.09em;color:#11151a">2013 – 16</p></div></div>';

  /* --- gemelos: el mismo mapa bajo dos lecturas --- */
  function gemelo(id, clave, rampa) {
    const s = document.getElementById(id); if (!s) return;
    s.setAttribute('viewBox', `0 0 ${D.w} ${D.h}`);
    const vs = M.map(m => m[clave]), a = Math.min(...vs), z = Math.max(...vs);
    const g1 = el('g'), g2 = el('g');
    M.forEach(m => {
      g1.appendChild(el('path', { d: m.d, fill: tono(rampa, z === a ? .5 : (m[clave] - a) / (z - a)), stroke: '#191d21', 'stroke-width': '.9' }));
      if (m.dron) g2.appendChild(el('path', { d: m.d, class: 'ataque' }));
    });
    s.append(g1, g2);
  }
  gemelo('gem-a', 'riesgo', 'ambar');
  gemelo('gem-b', 'idx', 'agua');

  pintarGira(); pintar();
  elegir(M.find(m => m.m.indexOf('Litoral') >= 0).cod);
})();
</script>
